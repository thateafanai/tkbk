<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications (Firebase Cloud Messaging, for Scripture of the Day).
	     "development" is correct here: when you archive for the App Store,
	     Xcode's signing step swaps this to "production" automatically. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
